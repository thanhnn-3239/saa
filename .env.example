# ---- Supabase ----
# Local dev: run `pnpm db:start` then copy values from `pnpm db:status`.
# Production: use the Supabase Cloud project values (set in Vercel env, not here).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only secret — NEVER prefix with NEXT_PUBLIC_ (must not reach the browser bundle).
SUPABASE_SECRET_KEY=

# ---- Google OAuth (Supabase Auth provider) ----
# Local dev: substituted into supabase/config.toml ([auth.external.google]).
# Production: configure the Google provider in the Supabase Cloud dashboard instead.
# Create an OAuth 2.0 Client (Web application) in Google Cloud Console.
# Authorized redirect URI must be: <SUPABASE_URL>/auth/v1/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
