# ---- Supabase ----
# Local dev: run `pnpm db:start` then copy values from `pnpm db:status`.
# Production: use the Supabase Cloud project values (set in Vercel env, not here).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only secret — NEVER prefix with NEXT_PUBLIC_ (must not reach the browser bundle).
# Now used by the auto-login backdoor's service-role client (see AUTO_LOGIN_TOKEN below).
SUPABASE_SECRET_KEY=

# ---- Auto-login backdoor for test/E2E (DEV ONLY) ----
# Set a random secret string to ENABLE GET /auto-login. Empty = disabled (404).
# Requests must carry this token (header x-auto-login-token or ?token=).
# WARNING: NEVER set this on production (Vercel) — anyone with the token could
# log in as any internal user. Reuses SUPABASE_SECRET_KEY for the service-role client.
AUTO_LOGIN_TOKEN=

# ---- Dev-only extra seeds (test users for auto-login / E2E) ----
# Point at the dev seed to create admin-test/member-test + members on `pnpm db:reset`.
# Leave unset to skip. Loaded via supabase/config.toml sql_paths env() hook.
SUPABASE_EXTRA_SEEDS=./seeds/dev/seed.sql

# ---- Google OAuth (Supabase Auth provider) ----
# Local dev: substituted into supabase/config.toml ([auth.external.google]).
# Production: configure the Google provider in the Supabase Cloud dashboard instead.
# Create an OAuth 2.0 Client (Web application) in Google Cloud Console.
# Authorized redirect URI must be: <SUPABASE_URL>/auth/v1/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- SAA Event ----
# ISO-8601 datetime (with timezone offset) for the SAA 2025 award ceremony.
# Used by the homepage countdown timer. Must include timezone offset (e.g. +07:00).
# Set this in Vercel environment variables for production.
NEXT_PUBLIC_EVENT_DATETIME=2025-12-26T18:30:00+07:00
