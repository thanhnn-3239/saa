# Local development image for the Next.js dev server (hot reload).
# Backend (Postgres/Auth/Storage/Realtime) is run separately by the Supabase CLI.
# Alpine base (~55MB) is lighter than slim (~80MB); libc6-compat lets native
# modules like sharp load under musl.
FROM node:24-alpine

RUN apk add --no-cache libc6-compat
RUN corepack enable
WORKDIR /app

# Install deps first for layer caching. pnpm-workspace.yaml carries the
# build-script approval (allowBuilds) so sharp/unrs-resolver compile cleanly.
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile

COPY . .

EXPOSE 3000

# Polling so file changes are detected inside the container (Turbopack HMR).
ENV WATCHPACK_POLLING=true
ENV CHOKIDAR_USEPOLLING=true

CMD ["pnpm", "dev"]
